{
  "version": 4,
  "configurations": [
    {
      "name": "Windows",
      "includePath": [
        "C:/raylib/include", // Raylib headers
        "${workspaceFolder}/**" // Your project's include files
      ],
      "defines": [],
      "intelliSenseMode": "gcc-x86", // Use this for both 32-bit and 64-bit setups
      "compilerPath": "C:/mingw/bin/g++.exe", // Adjust path if necessary
      "cStandard": "c11",
      "cppStandard": "c++17",
      "browse": {
        "path": [
          "C:/raylib/include", // Raylib headers for browsing
          "${workspaceFolder}/**"
        ],
        "limitSymbolsToIncludedHeaders": true
      }
    }
  ]
}
