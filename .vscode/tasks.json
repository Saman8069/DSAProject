{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "type": "shell",
      "command": "g++",
      "args": [
        "-I${workspaceFolder}/include",
        "-IC:/raylib/include", // Raylib headers
        "${workspaceFolder}/main.cpp", // Your main source file
        "${workspaceFolder}/solveSudoku.cpp",
        "${workspaceFolder}/checkSudoku.cpp",
        "-LC:/raylib/lib", // Raylib library path
        "-lraylibdll", // Link against the Raylib DLL
        "-lopengl32", // Link OpenGL
        "-lgdi32", // Windows GDI
        "-lwinmm", // Multimedia
        "-o",
        "${workspaceFolder}/sudoku.exe" // Output executable
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"],
      "detail": "Generated task for building Sudoku."
    }
  ]
}
